PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
API_RATE_LIMIT=300
PAYMENT_RATE_LIMIT=30

DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=broadband_db

# Railway MySQL also works with its built-in MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD, and MYSQLDATABASE variables.
MYSQLHOST=your-railway-mysql-host
MYSQLPORT=your-railway-mysql-port
MYSQLUSER=your-railway-mysql-user
MYSQLPASSWORD=your-railway-mysql-password
MYSQLDATABASE=your-railway-mysql-database

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Email SMTP. Use MSG91 SMTP Integration values here after verifying your sending domain in MSG91.
SMTP_HOST=your-msg91-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=NetWave <noreply@your-verified-domain.com>
SMTP_SECURE=false
SMTP_FORCE_IPV4=true
TEST_EMAIL_TO=your-test-recipient@example.com

WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_BILL_DUE=bill_due_reminder_v2
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=payment_received
WHATSAPP_TEMPLATE_ACCOUNT_APPROVED=account_approved
WHATSAPP_TEMPLATE_ACCOUNT_REJECTED=account_rejected
TEST_WHATSAPP_TO=

# MSG91 WhatsApp. Preferred if your WhatsApp number/templates are managed in MSG91.
MSG91_WHATSAPP_AUTHKEY=your-msg91-authkey
MSG91_WHATSAPP_INTEGRATED_NUMBER=91XXXXXXXXXX
MSG91_WHATSAPP_TEMPLATE_NAMESPACE=
MSG91_WHATSAPP_API_URL=https://control.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/

SMS_API_URL=
SMS_API_KEY=
SMS_FROM=NetWave
SMS_DUPLICATE_WINDOW_MS=12000

# MSG91 SMS. Preferred for India production SMS.
# Create MSG91 SMS Flow/Templates with the variables shown below, complete DLT setup,
# then add the Flow IDs in Render. MSG91_FLOW_ID is a fallback if you use one flow.
MSG91_AUTHKEY=your-msg91-authkey
MSG91_FLOW_ID=your-msg91-flow-id
MSG91_FLOW_ID_BILL_DUE=your-bill-due-flow-id
MSG91_FLOW_ID_PAYMENT_RECEIVED=your-payment-received-flow-id
MSG91_FLOW_ID_ACCOUNT_APPROVED=your-account-approved-flow-id
MSG91_FLOW_ID_ACCOUNT_REJECTED=your-account-rejected-flow-id
MSG91_SENDER=NETWAV
MSG91_ROUTE=
MSG91_SMS_API_URL=https://api.msg91.com/api/v5/flow/
MSG91_MESSAGE_VAR=message

# MSG91 SMS template examples:
# Create DLT templates with {#var#}, then create matching MSG91 Flow/Templates
# using variable names amount, due_date, bill_id, and name.
# Do not create one full-message variable like ##message##; DLT variables must be short.
# Bill reminder DLT content:
# NetWave reminder: your broadband bill of Rs. {#var#} is pending. Last date for payment: {#var#}. Please pay before this date.
# Payment receipt DLT content:
# NetWave payment received. We received Rs. {#var#} for bill ID {#var#}. Thank you.
# Account approved DLT content:
# NetWave: Hi {#var#}, your broadband account is approved. You can now log in and use your customer dashboard.
# Account rejected DLT content:
# NetWave: Hi {#var#}, your broadband registration could not be approved. Please contact support for help.

TEST_SMS_TO=

BILL_DOWNLOAD_SECRET=change-this-bill-link-secret
BILL_DOWNLOAD_TTL_HOURS=168
